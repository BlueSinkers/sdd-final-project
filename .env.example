# Copy to .env (git-ignored) before `docker compose up`, and change the values.
# Local only: Azure gets its passwords from GitHub Actions secrets.
# SQL Server rejects weak passwords (8+ characters with upper, lower and a digit).
# Use letters, digits and _ only, because the values also go inside a URL.
SA_PASSWORD=Change_me_Sa_1
LISTINGS_DB_PASSWORD=Change_me_Listings_1
SWAPS_DB_PASSWORD=Change_me_Swaps_1

# Optional: change a host port if something else on your machine already uses it.
# LISTINGS_PORT=8001
# SWAPS_PORT=8002
# SQL_PORT=1433
# UI_PORT=8080
# If you change LISTINGS_PORT or SWAPS_PORT, change the two URLs in ui/config.js to match.
